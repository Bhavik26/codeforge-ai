# Application
NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/codeforge_dev
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Code Execution
JUDGE_MAX_EXECUTION_TIME=5000
JUDGE_MAX_MEMORY_USAGE=256
DOCKER_NETWORK=bridge

# AI Services
OPENAI_API_KEY=
CLAUDE_API_KEY=
ENABLE_AI_REVIEWS=true

# Email
SENDGRID_API_KEY=
EMAIL_FROM=noreply@codeforgeai.com

# Storage
S3_BUCKET=
S3_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_MAX_FILES=14

# Monitoring
DATADOG_API_KEY=
ENABLE_DATADOG=false
